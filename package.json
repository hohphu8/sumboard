{
  "name": "sumboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4220 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4221 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "gyosjs": "0.5.5"
  },
  "devDependencies": {
    "vite": "6.4.6",
    "@playwright/test": "1.55.1"
  }
}
